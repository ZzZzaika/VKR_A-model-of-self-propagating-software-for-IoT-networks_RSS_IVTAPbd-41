	<JavaClasses>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1780085563698</Id>
			<Name><![CDATA[DeviceConfig]]></Name>
			<Text><![CDATA[import java.io.Serializable;

public class DeviceConfig implements Serializable {
	public String name;
	public double x;
	public double y;
	public double cvss;
	public String segment;
	public String gatewaySegments;
	public String deviceLogin;
	public String devicePassword;
	public double minPatchKB;
	public double maxPatchKB;
	public double minInstallSec;
	public double maxInstallSec;

	public DeviceConfig(String name, double x, double y,
			double cvss, String segment,
			String gatewaySegments, String deviceLogin,
			String devicePassword, double minPatchKB,
			double maxPatchKB, double minInstallSec,
			double maxInstallSec) {
		this.name = name;
		this.x = x;
		this.y = y;
		this.cvss = cvss;
		this.segment = segment;
		this.gatewaySegments = gatewaySegments;
		this.deviceLogin = deviceLogin;
		this.devicePassword = devicePassword;
		this.minPatchKB = minPatchKB;
		this.maxPatchKB = maxPatchKB;
		this.minInstallSec = minInstallSec;
		this.maxInstallSec = maxInstallSec;
	}

	@Override
	public String toString() {
		return name + " (CVSS: " + cvss + ", Подсеть: "
				+ segment + ")";
	}
}]]></Text>
		</JavaClass>
	</JavaClasses>
