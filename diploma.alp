				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1774357198715</Id>
					<Name><![CDATA[Infected]]></Name>
					<X>230</X><Y>290</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[traceln("[" + time() + "] " + getName() + " стал Infected");
shape.setFillColor(red);
get_Main().triggerDetectionIfNeeded();
Main main = get_Main();
double parentRZero = infectingVirus.rzeroScore;

Runnable performAttack = () -> {
	ArrayList<IoTDevice> visibleTargets = main
			.getVisibleDevices(IoTDevice.this);

	ArrayList<IoTDevice> validTargets = new ArrayList<>();

	for (IoTDevice d : visibleTargets) {
		if (infectingVirus.canInfect(d)) {
			validTargets.add(d);
		}
	}

	if (validTargets.size() > 0) {
		int numTargets = (int) min(poisson(main.rzero),
				validTargets.size());
		for (int i = 0; i < numTargets; i++) {
			int idx = uniform_discr(0,
					validTargets.size() - 1);
			main.createVirus(parentRZero,
					validTargets.get(idx));
		}
	}
};

performAttack.run();
scanTimerEvent.restart();]]></EntryAction>
						<ExitAction><![CDATA[scanTimerEvent.reset();]]></ExitAction>
						<FillColor>-65536</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1774357201899</Id>
					<Name><![CDATA[Recovered]]></Name>
					<X>230</X><Y>390</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[traceln("[" + time() + "] " + getName()
		+ " излечен (Recovered)");
shape.setFillColor(green);]]></EntryAction>
						<FillColor>-16744448</FillColor>
					</Properties>
				</StatechartElement>
