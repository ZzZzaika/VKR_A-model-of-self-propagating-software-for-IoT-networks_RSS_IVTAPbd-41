					<ShowLabel>true</ShowLabel>
					<AutoUpdate>false</AutoUpdate>
					<RecurrenceProperties>
						<Id>1780248148451</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1780300800000</OccurrenceDate>
